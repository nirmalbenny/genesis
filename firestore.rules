rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      // AI credit ledger: readable by its owner, written only by Cloud Functions.
      match /creditLedger/{entry} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }
    match /hlTokens/{uid} { allow read, write: if false; }
    match /oauthStates/{state} { allow read, write: if false; }

    // All writes to projects and their subcollections go through Cloud Functions (Admin SDK).
    match /projects/{pid} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow write: if false;

      match /{sub=**} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/projects/$(pid)).data.ownerId == request.auth.uid;
        allow write: if false;
      }
    }
  }
}
