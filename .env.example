# Genesis — every environment variable, grouped by the file it belongs in.
# None of the real files are committed (see .gitignore). Copy the per-package templates:
#   cp functions/.env.example functions/.env      cp frontend/.env.example frontend/.env.local

# ───────────────────────── functions/.env  (shared: emulator + deploy) ─────────────────────────
ANTHROPIC_MODEL=                     # Claude model used for generation, e.g. claude-sonnet-5-5
ANTHROPIC_SUMMARY_MODEL=claude-haiku-5-5   # small model for one-line snapshot summaries

# ───────────────────────── functions/.env.local  (emulator only, never deployed) ─────────────────
HL_REDIRECT_URI=                     # http://127.0.0.1:5001/<project-id>/us-central1/hlAuthCallback
APP_URL=                             # http://localhost:5173  (where the OAuth callback sends the browser back)

# ───────────────────────── functions/.env.<project-id>  (production, used by `firebase deploy`) ──
# HL_REDIRECT_URI=https://us-central1-<project-id>.cloudfunctions.net/hlAuthCallback
# APP_URL=https://<project-id>.web.app

# ───────────────────────── Secrets: functions/.secret.local (emulator) / Secret Manager (prod) ───
# Never put these in a .env file. Prod: firebase functions:secrets:set <NAME>
# ANTHROPIC_API_KEY=                 # console.anthropic.com → API keys
# HL_CLIENT_ID=                      # HighLevel Marketplace app → Advanced Settings → Auth
# HL_CLIENT_SECRET=                  # same place
# PREVIEW_TOKEN_SECRET=              # any long random string, e.g. `openssl rand -hex 32`

# ───────────────────────── frontend/.env.local (dev)  /  frontend/.env.production (build) ────────
VITE_FIREBASE_API_KEY=               # Firebase console → Project settings → Your apps → Web app config (public by design)
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FUNCTIONS_BASE_URL=             # dev: set automatically by `npm run dev` (tunnel) · prod: https://us-central1-<project-id>.cloudfunctions.net
VITE_USE_EMULATORS=                  # true in .env.local, false in .env.production
