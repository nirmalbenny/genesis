{
  "name": "genesis-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc && cp src/llm/hlReference.md src/llm/uiKit.md lib/llm/ && rm -rf lib/hl-resources && cp -R ../hl-resources lib/hl-resources",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test lib/*.test.js lib/llm/*.test.js lib/hl/*.test.js lib/files/*.test.js lib/observability/*.test.js",
    "test:e2e": "npm run build && node --test --test-concurrency=1 lib/e2e/*.e2e.js",
    "lint": "eslint .",
    "migrate:files": "npm run build && node lib/scripts/migrate-files-to-storage.js",
    "measure:files": "npm run build && node lib/scripts/measure-filestore.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@google-cloud/kms": "^6.3.0",
    "@langfuse/otel": "6.1.1",
    "@langfuse/tracing": "6.1.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/otlp-exporter-base": "0.223.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@vue/compiler-sfc": "3.5.45",
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^6.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2"
  }
}
