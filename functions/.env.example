# Functions config — three files, none committed (copy this one as a starting point):
#   functions/.env                    shared non-secret params (emulator + deploy)
#       ANTHROPIC_MODEL=
#       ANTHROPIC_SUMMARY_MODEL=claude-haiku-5-5
#   functions/.env.local              emulator-only overrides (highest priority locally, never deployed)
#       HL_REDIRECT_URI=http://127.0.0.1:5001/<project-id>/us-central1/hlAuthCallback
#       APP_URL=http://localhost:5173
#   functions/.env.<project-id>       production values used by `firebase deploy`
#       HL_REDIRECT_URI=https://us-central1-<project-id>.cloudfunctions.net/hlAuthCallback
#       APP_URL=https://<project-id>.web.app
# Secrets: functions/.secret.local (emulator) and Secret Manager (prod) — never in these files:
#   ANTHROPIC_API_KEY, HL_CLIENT_ID, HL_CLIENT_SECRET, PREVIEW_TOKEN_SECRET
ANTHROPIC_MODEL=
ANTHROPIC_SUMMARY_MODEL=claude-haiku-5-5
HL_REDIRECT_URI=
APP_URL=
