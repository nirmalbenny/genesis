# Copy to frontend/.env.local for local dev (and frontend/.env.production for deploy builds).
# Firebase web app config — Firebase console → Project settings → Your apps → Web. Public by design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Functions base URL. Local: `npm run dev` sets this to a Cloudflare tunnel automatically (overrides this value).
# Production: https://us-central1-<project-id>.cloudfunctions.net
VITE_FUNCTIONS_BASE_URL=http://127.0.0.1:5001/<project-id>/us-central1
# true locally (Auth + Firestore emulators), false in .env.production
VITE_USE_EMULATORS=true
